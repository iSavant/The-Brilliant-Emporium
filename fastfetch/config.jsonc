{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "none"
  },
  "display": {
    "separator": "  ",
    "key": {
      "width": 33
    },
    "color": {
      "keys": "#8E8A8C",
      "output": "#D8D1D3"
    },
    "brightColor": false,
    "percent": {
      "type": 1
    },
    "disableLinewrap": false
  },
  "modules": [
    {
      "type": "title",
      "format": "\u001b[38;2;216;209;211m {host-name} \u001b[38;2;186;183;182m// \u001b[38;2;142;138;140m{user-name<37}\u001b[1;38;2;6;7;8;48;2;186;183;182m ◆ 777 \u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;52;59;64m ───────────────────────────────────────────────────────────────\u001b[0m"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;52;59;64m                    │  \u001b[38;2;186;183;182m01 // \u001b[38;2;142;138;140mSYSTEM \u001b[38;2;52;59;64m────────────────────────────\u001b[0m"
    },
    {
      "type": "os",
      "key": " ⠀⠀⠀\u001b[38;2;186;183;182m⢀⣠⡴⠶⠶⠶⠶\u001b[38;2;102;103;107m⣦\u001b[38;2;186;183;182m⣄⡀⠀⠀⠀   \u001b[38;2;52;59;64m│  \u001b[38;2;142;138;140mOS",
      "format": "{name}"
    },
    {
      "type": "kernel",
      "key": " ⠀\u001b[38;2;186;183;182m⢀⣴⣿\u001b[38;2;102;103;107m⡝⠀⠀⠀⠀⠀⡿⣯\u001b[38;2;186;183;182m⠻⣦⡀⠀   \u001b[38;2;52;59;64m│  \u001b[38;2;142;138;140mKERNEL",
      "format": "{release}"
    },
    {
      "type": "wm",
      "key": " ⠀\u001b[38;2;186;183;182m⣾\u001b[38;2;102;103;107m⢽⣿⠀⠀⠀⠀⠀⢔⣽⡿⠀\u001b[38;2;186;183;182m⠈⣷⠀   \u001b[38;2;52;59;64m│  \u001b[38;2;142;138;140mWM",
      "format": "{pretty-name}{?version} {version}{?}"
    },
    {
      "type": "terminal",
      "key": " \u001b[38;2;186;183;182m⢸⡇\u001b[38;2;102;103;107m⡘⣿⣄⢀⣀⣄⣠⣾⡿⠁⢀⡠\u001b[38;2;186;183;182m⢸⡇   \u001b[38;2;52;59;64m│  \u001b[38;2;142;138;140mTERM",
      "format": "{pretty-name}{?version} {version}{?}"
    },
    {
      "type": "custom",
      "format": " \u001b[38;2;186;183;182m⠸⣇\u001b[38;2;102;103;107m⢸⢿⣏⣈⣻⣿⣿⣿⣿⣿⣿⠃\u001b[38;2;186;183;182m⣸⠇   \u001b[38;2;52;59;64m│\u001b[0m"
    },
    {
      "type": "custom",
      "format": " ⠀\u001b[38;2;186;183;182m⢻⣜\u001b[38;2;102;103;107m⣿⣿⢿⣯⣬⣿⣿⣿⣿⠇\u001b[38;2;186;183;182m⣠⡟⠀   \u001b[38;2;52;59;64m│  \u001b[38;2;186;183;182m02 // \u001b[38;2;142;138;140mHARDWARE \u001b[38;2;52;59;64m──────────────────────────\u001b[0m"
    },
    {
      "type": "cpu",
      "key": " ⠀⠀\u001b[38;2;186;183;182m⠙\u001b[38;2;102;103;107m⢿⣿⣤⣽⣵⣾⣿⣿⣿\u001b[38;2;186;183;182m⡾⠋⠀⠀   \u001b[38;2;52;59;64m│  \u001b[38;2;142;138;140mCPU",
      "format": "{name} · {cores-physical}C/{cores-logical}T"
    },
    {
      "type": "gpu",
      "key": " ⠀⠀⠀\u001b[38;2;102;103;107m⠈⢿⣿⣿⣾⣿⣿⡟⠋⠀⠀⠀⠀   \u001b[38;2;52;59;64m│  \u001b[38;2;142;138;140mGPU",
      "hideType": "integrated",
      "format": "{name:-31}"
    },
    {
      "type": "memory",
      "key": " ⠀⠀⠀⠀⠀\u001b[38;2;102;103;107m⠹⢿⣿⠟⠉⠀⠀⠀⠀⠀⠀   \u001b[38;2;52;59;64m│  \u001b[38;2;142;138;140mRAM",
      "format": "{used} / {total} {#38;2;142;138;140}[ {percentage} ]{#}"
    },
    {
      "type": "disk",
      "folders": "/",
      "key": " \u001b[38;2;216;209;211mᛊᚺᚨᛞᛟᚹ ᛊᛚᚨᚹᛖ       \u001b[38;2;52;59;64m│  \u001b[38;2;142;138;140mDISK",
      "format": "{size-used} / {size-total} {#38;2;142;138;140}[ {size-percentage} ]{#}"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;186;183;182m // \u001b[38;2;142;138;140mTHE BRILLIANT   \u001b[38;2;52;59;64m│\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;142;138;140m    EMPORIUM        \u001b[38;2;52;59;64m│\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;142;138;140m THE WAKING WORLD   \u001b[38;2;52;59;64m│\u001b[0m"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;52;59;64m ───────────────────────────────────────────────────────────────\u001b[0m"
    },
    {
      "type": "uptime",
      "key": " UPTIME",
      "keyWidth": 10,
      "format": "{?days}{days}d {?}{hours}h {minutes}m     {#38;2;142;138;140}01 ── 02 ── 03 ── {#38;2;186;183;182}04 ◆{#}"
    }
  ]
}
